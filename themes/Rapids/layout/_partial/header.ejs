<header class="site-head">
  <div class="wrap site-head__inner">
    <a class="brand" href="<%= url_for('/') %>" aria-label="<%= config.title %>">
      <img class="brand__logo" src="<%= url_for('/logo-on-dark.svg') %>" alt="" height="40">
    </a>

    <nav class="nav" id="site-nav" aria-label="主导航">
      <ul class="nav__list">
        <% theme.menu.forEach(function(item) { %>
          <li class="nav__item<%= (item === 'home' && is_home()) || (item === 'archives' && is_archive()) || (item === 'tags' && page.type === 'tags') || (item === 'categories' && page.type === 'categories') || (item === 'about' && page.path && page.path.indexOf('about/') === 0) ? ' is-active' : '' %>">
            <% if (item === 'rss') { %>
              <a href="<%= url_for('/atom.xml') %>">
                <span class="nav__zh"><%= __('menu.' + item) %></span>
                <span class="nav__en" aria-hidden="true"><%= __('nav_en.' + item) %></span>
              </a>
            <% } else { %>
              <a href="<%= url_for(item === 'home' ? '/' : item + '/') %>">
                <span class="nav__zh"><%= __('menu.' + item) %></span>
                <span class="nav__en" aria-hidden="true"><%= __('nav_en.' + item) %></span>
              </a>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </nav>

    <div class="site-head__tools">
      <% if (theme.search && theme.search.enable) { %>
        <button type="button" class="icon-btn" id="search-open" aria-label="<%= __('search.open') %>" title="<%= __('search.open') %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
        </button>
      <% } %>
      <button type="button" class="icon-btn nav-toggle" id="nav-toggle" aria-label="菜单" aria-expanded="false" aria-controls="site-nav">
        <svg class="nav-toggle__open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="nav-toggle__close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
</header>
