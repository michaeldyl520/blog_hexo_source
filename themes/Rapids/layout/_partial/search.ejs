<div class="search" id="search" hidden>
  <div class="search__backdrop" data-search-close></div>
  <div class="search__panel" role="dialog" aria-modal="true" aria-label="<%= __('search.open') %>">
    <div class="search__bar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
      <input type="search" id="search-input" placeholder="<%= __('search.placeholder') %>" autocomplete="off" spellcheck="false" aria-label="<%= __('search.placeholder') %>">
      <button type="button" class="search__close" data-search-close aria-label="关闭">ESC</button>
    </div>
    <p class="search__status" id="search-status" aria-live="polite"><%= __('search.hint') %></p>
    <ul class="search__results" id="search-results"></ul>
  </div>
</div>
<script>
  window.__RAPIDS_SEARCH__ = {
    index: <%- JSON.stringify(url_for('/content.json')) %>,
    i18n: {
      empty: <%- JSON.stringify(__('search.empty')) %>,
      error: <%- JSON.stringify(__('search.error')) %>,
      count: <%- JSON.stringify(__('search.count')) %>,
      hint: <%- JSON.stringify(__('search.hint')) %>
    }
  };
</script>
